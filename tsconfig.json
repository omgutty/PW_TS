{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "nodenext",
    "target": "esnext",
    "types": [],
    //without this also it is working but it is recommended to add this for nodejs environment
    // i need to import with .js extension in ts file because of module nodenext and 
    // for that i need to add this option
    //"allowImportingTsExtensions": true
    // For nodejs:
   
  },
  "include":[
    "src/**/*.ts"
, "src/test.js", "src/typetry"  ],
  "exclude":[
    "dist"
  ]
}


